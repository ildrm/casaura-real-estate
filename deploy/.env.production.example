# Copy only for a production-like local rehearsal. Real deployments inject secrets
# from the hosting platform and never commit the populated file.
CASAURA_API_IMAGE=registry.example/casaura-api@sha256:replace
CASAURA_API_NGINX_IMAGE=registry.example/casaura-api-nginx@sha256:replace
CASAURA_WEB_IMAGE=registry.example/casaura-web@sha256:replace
RELEASE_ID=git-sha
APP_KEY=
APP_URL=https://api.casaura.example
FRONTEND_URL=https://casaura.example
SESSION_DOMAIN=.casaura.example
SANCTUM_STATEFUL_DOMAINS=casaura.example
DB_HOST=
DB_PORT=5432
DB_DATABASE=casaura
DB_USERNAME=
DB_PASSWORD=
REDIS_URL=rediss://user:password@redis.example:6379/0
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=delivery@casaura.example
LEGAL_DOCUMENT_VERSION=replace-with-approved-version
LEGAL_DOCUMENT_TEXT=replace-with-approved-consent-text
INQUIRY_CONSENT_VERSION=replace-with-approved-version
INQUIRY_CONSENT_TEXT=replace-with-approved-inquiry-consent-text
