APP_NAME=Casaura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
PRODUCTION_GUARD_ENABLED=true
RELEASE_ID=development
OPERATIONS_HEARTBEAT_TTL_SECONDS=180
OPERATIONS_REQUIRE_WORKER_HEARTBEAT=false
OPERATIONS_REQUIRE_SCHEDULER_HEARTBEAT=false
OPERATIONS_QUEUE_BACKLOG_DEGRADED=1000
OPERATIONS_SEARCH_BACKLOG_DEGRADED=100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=casaura
DB_USERNAME=casaura
DB_PASSWORD=casaura_local_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
LEGAL_DOCUMENT_VERSION=2026-08-22
LEGAL_DOCUMENT_TEXT="By creating an account, the user accepts the Casaura Terms of Service and acknowledges the Privacy Notice."
INVITATION_TTL_HOURS=72
MFA_ISSUER=Casaura

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LISTING_MEDIA_DISK=local
PRIVACY_EXPORT_DISK=local
MEDIA_SCANNER=signature
CLAMAV_ADDRESS=tcp://clamav:3310
CLAMAV_TIMEOUT_SECONDS=10
MEDIA_QUARANTINE_RETENTION_DAYS=30
PRIVACY_EXPORT_RETENTION_DAYS=7
PRIVACY_ANALYTICS_PSEUDONYMIZE_DAYS=7
PRIVACY_ANALYTICS_DELETE_DAYS=90
PRIVACY_ORPHAN_INVITATION_DAYS=7
INQUIRY_CONSENT_VERSION=2026-08-22
INQUIRY_CONSENT_TEXT="I agree that Casaura can share these details with the responsible agency for this property inquiry."
QUEUE_CONNECTION=database

SEARCH_DRIVER=database
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=casaura-listings-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT=3
SEARCH_MAX_RADIUS_KM=200
SEARCH_ALLOW_DESTRUCTIVE_RESET=false

RESO_PAGE_SIZE=200
RESO_TIMEOUT_SECONDS=15
RESO_RAW_PAYLOAD_RETENTION_DAYS=30
RESO_APPROVED_ORIGINS=
RESO_SECRET_DIRECTORY=

AI_DRIVER=deterministic
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=800
AI_CONTENT_RETENTION_DAYS=30

BILLING_DRIVER=deterministic
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL=https://api.stripe.com
STRIPE_API_VERSION=2025-07-30.basil
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/agency/billing?checkout=success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/agency/billing?checkout=cancelled
BILLING_PORTAL_RETURN_URL=http://localhost:3000/agency/billing

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@casaura.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated emergency feature kill switch. Ordinary settings live in the database.
FEATURE_FORCE_OFF=
